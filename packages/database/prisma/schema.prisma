generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelType {
  WHATSAPP
  WEB_CHAT
  CITIZEN_WEB
  MOBILE_APP
  OPERATOR
  INSTAGRAM
  FACEBOOK
  SMS
  EMAIL
  TELEGRAM
  TWITTER
}

enum TicketStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  WAITING_INFO
  RESOLVED
  CLOSED
  REJECTED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageVisibility {
  PUBLIC
  INTERNAL
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  DEPARTMENT_STAFF
  OPERATOR
  READ_ONLY
}

enum AuditActorType {
  USER
  CITIZEN
  AI
  SYSTEM
  WEBHOOK
}

enum CitizenIdentifierKind {
  PHONE
  EMAIL
}

enum CitizenIdentifierSource {
  PUBLIC_WEB
  WEB_CHAT
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  SMS
  EMAIL
  STAFF
  IMPORT
  MERGE
}

enum OutboundDeliveryState {
  PENDING
  DISPATCHED
  DELIVERED
  FAILED
  SKIPPED
}

model Tenant {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  timezone             String   @default("Europe/Istanbul")
  locale               String   @default("tr-TR")
  status               String   @default("ACTIVE")
  widgetEnabled        Boolean  @default(true)
  widgetTitle          String   @default("Belediye asistanı")
  widgetWelcome        String   @default("Merhaba, belediyeye iletmek istediğiniz konuyu yazın.")
  widgetAllowedOrigins Json?
  retentionOverrides   Json?
  aiBudgetOverrides    Json?
  ipAllowlist          Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  aiRuns               AiRun[]
  auditLogs            AuditLog[]
  cannedReplies        CannedReply[]
  categories           Category[]
  channelEvents        ChannelEvent[]
  citizenIdentifiers   CitizenIdentifier[]
  citizens             Citizen[]
  conversations        Conversation[]
  departments          Department[]
  kvkkConsentVersions  KvkkConsentVersion[]
  managerReports       ManagerReport[]
  messageTemplates     MessageTemplate[]
  outboundDeliveries   OutboundDelivery[]
  neighborhoods        Neighborhood[]
  slaPolicies          SlaPolicy[]
  ticketTags           TicketTag[]
  tickets              Ticket[]
  users                User[]
  webhooks             TenantWebhook[]
  deviceTokens         CitizenDeviceToken[]
  whatsappTemplates    WhatsappTemplate[]
  notificationSinks    NotificationSink[]
  reportSubscriptions  ReportSubscription[]
  faqArticles          FaqArticle[]
  appointmentSlots     AppointmentSlot[]
  appointments         Appointment[]
  socialMonitorRules   SocialMonitorRule[]
  ivrCalls             IvrCall[]
}

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories    Category[]
  neighborhoods Neighborhood[]
  slaPolicies   SlaPolicy[]
  tickets       Ticket[]
  users         UserDepartment[]
  appointmentSlots AppointmentSlot[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Category {
  id              String         @id @default(cuid())
  tenantId        String
  departmentId    String?
  name            String
  code            String
  description     String?
  defaultPriority TicketPriority @default(NORMAL)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  slaPolicies     SlaPolicy[]
  tickets         Ticket[]

  @@unique([tenantId, code])
  @@index([tenantId, departmentId])
  @@index([tenantId, isActive])
}

model Neighborhood {
  id             String  @id @default(cuid())
  tenantId       String
  name           String
  code           String?
  polygonGeoJson Json?
  departmentId   String?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tickets        Ticket[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@index([tenantId, departmentId])
}

model SlaPolicy {
  id                String         @id @default(cuid())
  tenantId          String
  departmentId      String?
  categoryId        String?
  priority          TicketPriority
  responseMinutes   Int
  resolutionMinutes Int
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  category          Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, departmentId, categoryId, priority])
  @@index([tenantId, priority])
  @@index([tenantId, departmentId, categoryId])
}

model MessageTemplate {
  id        String       @id @default(cuid())
  tenantId  String
  key       String
  channel   ChannelType?
  locale    String       @default("tr-TR")
  body      String
  isActive             Boolean      @default(true)
  whatsappTemplateId   String?
  whatsappTemplateName String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash        String
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  totpSecret          String?
  totpEnabled         Boolean  @default(false)
  fullName            String
  role                UserRole
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTickets  Ticket[]         @relation("AssignedTickets")
  auditLogs        AuditLog[]
  departments      UserDepartment[]
  cannedReplies    CannedReply[]
  watchedTickets       TicketWatcher[]
  checklistItems       TicketChecklistItem[] @relation("ChecklistItemDoneBy")
  reportSubscriptions  ReportSubscription[]

  @@unique([tenantId, email])
  @@index([tenantId, role, isActive])
}

model UserDepartment {
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
}

model KvkkConsentVersion {
  id          String   @id @default(cuid())
  tenantId    String
  version     String
  summary     String
  contentUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citizens    Citizen[]

  @@unique([tenantId, version])
  @@index([tenantId, isActive])
}

model Citizen {
  id                    String    @id @default(cuid())
  tenantId              String
  displayName           String?
  phone                 String?
  email                 String?
  firebaseUid           String?
  kvkkConsentAt         DateTime?
  kvkkConsentVersionId  String?
  mergedIntoCitizenId   String?
  mergedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kvkkConsentVersion  KvkkConsentVersion? @relation(fields: [kvkkConsentVersionId], references: [id], onDelete: SetNull)
  mergedIntoCitizen   Citizen?            @relation("CitizenMerge", fields: [mergedIntoCitizenId], references: [id], onDelete: SetNull)
  mergedCitizens      Citizen[]           @relation("CitizenMerge")
  identifiers         CitizenIdentifier[]
  conversations       Conversation[]
  tickets             Ticket[]
  deviceTokens        CitizenDeviceToken[]
  appointments        Appointment[]

  @@unique([tenantId, firebaseUid])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, mergedIntoCitizenId])
}

model CitizenIdentifier {
  id              String                 @id @default(cuid())
  tenantId        String
  citizenId       String
  kind            CitizenIdentifierKind
  normalizedValue String
  isPrimary       Boolean                @default(false)
  isVerified      Boolean                @default(false)
  source          CitizenIdentifierSource
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citizen         Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, normalizedValue])
  @@index([tenantId, citizenId, kind])
  @@index([tenantId, kind, isPrimary])
}

model Ticket {
  id                     String         @id @default(cuid())
  tenantId               String
  ticketNo               String
  publicTrackingToken    String?
  citizenId              String?
  channel                ChannelType
  status                 TicketStatus   @default(NEW)
  priority               TicketPriority @default(NORMAL)
  categoryId             String?
  departmentId           String?
  assignedToId           String?
  neighborhoodId         String?
  title                  String
  description            String
  addressText            String?
  latitude               Decimal?       @db.Decimal(10, 7)
  longitude              Decimal?       @db.Decimal(10, 7)
  locationAccuracyMeters Int?
  firstResponseDueAt     DateTime?
  resolutionDueAt        DateTime?
  slaBreachedAt          DateTime?
  csatScore              Int?
  csatRespondedAt        DateTime?
  firstRespondedAt       DateTime?
  resolvedAt             DateTime?
  closedAt               DateTime?
  aiConfidence           Decimal?       @db.Decimal(4, 3)
  aiClassification       Json?
  duplicateOfTicketId    String?
  embeddingJson          String?        // FAZ 8.1: semantic duplicate detection (JSON-encoded float array)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo             User?         @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  category               Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  citizen                Citizen?      @relation(fields: [citizenId], references: [id], onDelete: SetNull)
  department             Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  neighborhood           Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  duplicateOfTicket      Ticket?       @relation("DuplicateTickets", fields: [duplicateOfTicketId], references: [id], onDelete: SetNull)
  duplicates             Ticket[]      @relation("DuplicateTickets")
  aiRuns                 AiRun[]
  attachments            Attachment[]
  auditLogs              AuditLog[]
  messages               TicketMessage[]
  tags                   TicketTag[]     @relation("TicketTags")
  watchers               TicketWatcher[]
  checklistItems         TicketChecklistItem[]

  @@unique([tenantId, ticketNo])
  @@unique([tenantId, publicTrackingToken])
  @@index([tenantId, status, priority])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, categoryId, status])
  @@index([tenantId, assignedToId, status])
  @@index([tenantId, resolutionDueAt])
  @@index([tenantId, status, resolutionDueAt])
  @@index([tenantId, status, resolvedAt])
  @@index([tenantId, slaBreachedAt])
  @@index([tenantId, createdAt])
}

model TicketMessage {
  id                String            @id @default(cuid())
  tenantId          String
  ticketId          String
  senderType        AuditActorType
  senderId          String?
  visibility        MessageVisibility
  body              String
  channel           ChannelType?
  externalMessageId String?
  createdAt         DateTime          @default(now())

  ticket            Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments       Attachment[]

  @@index([tenantId, ticketId, createdAt])
}

model Attachment {
  id              String         @id @default(cuid())
  tenantId        String
  ticketId        String?
  messageId       String?
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageKey      String
  publicUrl       String?
  checksumSha256  String?
  uploadedByType  AuditActorType
  scanStatus      AttachmentScanStatus @default(PENDING)
  scanProvider    String?
  scanThreat      String?
  scanResult      Json?
  scannedAt       DateTime?
  createdAt       DateTime       @default(now())

  ticket          Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message         TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId])
  @@index([tenantId, messageId])
  @@index([tenantId, scanStatus])
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
  SKIPPED
}

model Conversation {
  id                     String      @id @default(cuid())
  tenantId               String
  citizenId              String?
  channel                ChannelType
  externalConversationId String?
  state                  String      @default("OPEN")
  handoffRequested       Boolean     @default(false)
  context                Json?
  lastMessageAt          DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citizen                Citizen? @relation(fields: [citizenId], references: [id], onDelete: SetNull)

  @@index([tenantId, channel, externalConversationId])
  @@index([tenantId, handoffRequested])
}

model ChannelEvent {
  id              String      @id @default(cuid())
  tenantId        String
  channel         ChannelType
  provider        String
  externalEventId String?
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime    @default(now())

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel, createdAt])
  @@index([tenantId, processedAt])
}

model OutboundDelivery {
  id                     String                @id @default(cuid())
  tenantId               String
  conversationId         String?
  channel                ChannelType
  state                  OutboundDeliveryState @default(PENDING)
  recipientPhone         String?
  recipientEmail         String?
  externalConversationId String?
  externalMessageId      String?
  templateKey            String?
  body                   String
  attempts               Int                   @default(0)
  lastAttemptAt          DateTime?
  lastError              String?
  dispatchedAt           DateTime?
  deliveredAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  tenant                 Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel, state])
  @@index([tenantId, conversationId])
}

model AuditLog {
  id          String         @id @default(cuid())
  tenantId    String
  ticketId    String?
  actorType   AuditActorType
  actorUserId String?
  action      String
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

model TenantWebhook {
  id         String   @id @default(cuid())
  tenantId   String
  url        String
  secret     String
  events     Json     // string[] of event names
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

model CitizenDeviceToken {
  id         String   @id @default(cuid())
  tenantId   String
  citizenId  String
  platform   String   // 'ios' | 'android'
  token      String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citizen    Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@unique([tenantId, token])
  @@index([tenantId, citizenId])
}

model AiRun {
  id            String   @id @default(cuid())
  tenantId      String
  ticketId      String?
  purpose       String
  provider      String
  model         String
  promptVersion String
  input         Json
  output        Json
  confidence    Decimal? @db.Decimal(4, 3)
  latencyMs     Int?
  tokensInput   Int?
  tokensOutput  Int?
  tokensTotal   Int?
  costMicros    Int?
  success       Boolean  @default(true)
  errorReason   String?
  createdAt     DateTime @default(now())

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket        Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([tenantId, purpose, createdAt])
  @@index([tenantId, createdAt])
}

model ManagerReport {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  periodStart DateTime
  periodEnd   DateTime
  summary     String
  metrics     Json
  createdAt   DateTime @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, periodStart])
}

// FAZ 3.1: Canned reply templates
model CannedReply {
  id         String   @id @default(cuid())
  tenantId   String
  ownerId    String?  // null = shared; non-null = personal
  title      String
  body       String
  shortCode  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner      User?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([tenantId, ownerId, isActive])
}

// FAZ 3.2: Ticket tags / labels
model TicketTag {
  id       String @id @default(cuid())
  tenantId String
  name     String
  color    String @default("#6366f1")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets  Ticket[] @relation("TicketTags")

  @@unique([tenantId, name])
  @@index([tenantId])
}

// FAZ 3.4: Ticket watchers / followers
model TicketWatcher {
  tenantId  String
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([tenantId, userId])
}

// FAZ 3.5: Ticket sub-tasks / checklist
model TicketChecklistItem {
  id        String   @id @default(cuid())
  tenantId  String
  ticketId  String
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  doneAt    DateTime?
  doneById  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  doneBy    User?  @relation("ChecklistItemDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId])
}

// FAZ 6.2: Zamanlanmış rapor abonelikleri
model ReportSubscription {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  reportType  String
  frequency   String   @default("WEEKLY")  // DAILY | WEEKLY | MONTHLY
  email       String
  isActive    Boolean  @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([userId])
}

// FAZ 7.1: Bilgi bankası / FAQ
model FaqArticle {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  body        String
  lang        String   @default("tr")
  slug        String
  isPublished Boolean  @default(false)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug, lang])
  @@index([tenantId, lang, isPublished])
}

// FAZ 7.2: Randevu sistemi
model AppointmentSlot {
  id           String   @id @default(cuid())
  tenantId     String
  departmentId String?
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int      @default(1)
  booked       Int      @default(0)
  createdAt    DateTime @default(now())

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([tenantId, startsAt])
}

model Appointment {
  id            String   @id @default(cuid())
  tenantId      String
  slotId        String
  citizenId     String?
  citizenName   String
  citizenPhone  String?
  note          String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slot          AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  citizen       Citizen?        @relation(fields: [citizenId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([slotId])
}

// FAZ 5.3: WhatsApp template definitions
model WhatsappTemplate {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  language   String   @default("tr")
  category   String   @default("UTILITY")
  status     String   @default("PENDING")
  components Json     @default("[]")
  metaId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, language])
  @@index([tenantId])
}

// FAZ 5.4: Slack / MS Teams notification sinks
model NotificationSink {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  type       String   // SLACK | TEAMS
  webhookUrl String
  events     Json     @default("[\"ticket.created\",\"ticket.resolved\"]")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

// FAZ 8.4: Sosyal medya izleme kuralları
model SocialMonitorRule {
  id          String    @id @default(cuid())
  tenantId    String
  platform    String    @default("TWITTER")
  query       String
  isActive    Boolean   @default(true)
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

// FAZ 8.3: IVR çağrı kayıtları
model IvrCall {
  id           String   @id @default(cuid())
  tenantId     String
  callSid      String   @unique
  from         String
  to           String
  transcript   String?
  ticketId     String?
  status       String   @default("INITIATED")
  recordingUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

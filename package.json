{
  "name": "kentos-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @kentos/database prisma:generate",
    "db:migrate": "pnpm --filter @kentos/database prisma:deploy",
    "db:migrate:dev": "pnpm --filter @kentos/database prisma:migrate",
    "db:seed": "pnpm --filter @kentos/database prisma:seed",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:gateway": "node scripts/smoke-gateway.mjs",
    "e2e": "playwright test --config tests/playwright.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "verify:env": "node scripts/verify-env.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}

FROM node:22.15.0-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

RUN corepack enable
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:3100/api/v1
ARG NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://localhost:3100/api/v1
ARG NEXT_PUBLIC_CITIZEN_WEB_BASE_URL=http://localhost:3102
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_CITIZEN_WEB_BASE_URL=$NEXT_PUBLIC_CITIZEN_WEB_BASE_URL

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN pnpm install --frozen-lockfile
RUN pnpm db:generate
RUN pnpm build

FROM node:22.15.0-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

RUN corepack enable
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

# Non-root user: container escape riskini azalt
RUN useradd -m -u 1001 -s /bin/sh nodeuser

COPY --from=base /app /app
RUN chown -R nodeuser:nodeuser /app

USER nodeuser

CMD ["node", "-e", "console.error('Set a service command in docker-compose.prod.yml'); process.exit(1)"]

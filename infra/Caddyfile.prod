{
	email {$ACME_EMAIL}
}

# Ortak güvenlik başlıkları — tüm site bloklarında (import security_headers) ile kullanılır
(security_headers) {
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'strict-dynamic' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://firebaseapp.com https://*.googleapis.com https://api.anthropic.com wss: ws:; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

{$API_DOMAIN} {
	import security_headers
	reverse_proxy api:3100
}

{$ADMIN_DOMAIN} {
	import security_headers
	reverse_proxy admin-web:3101
}

{$CITIZEN_DOMAIN} {
	import security_headers

	# /widget/* paths: belediye sitelerine iframe gömme izni
	# Hassas sayfalar (login, account, report) global 'none' ile korunmaya devam eder.
	# frame-ancestors * güvenli: iframe parent cookie/localStorage'a erişemez;
	# hangi origin'in API'yi çağırabileceği widgetAllowedOrigins DB allowlist ile kontrol edilir.
	@widget_paths path /widget/*
	header @widget_paths Content-Security-Policy "default-src 'self'; script-src 'self' 'strict-dynamic' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://firebaseapp.com https://*.googleapis.com https://api.anthropic.com wss: ws:; font-src 'self' data:; frame-ancestors *; object-src 'none'; base-uri 'self'; form-action 'self'"

	reverse_proxy citizen-web:3102
}

{$GATEWAY_DOMAIN} {
	import security_headers
	reverse_proxy whatsapp-gateway:3120
}

{$MUNICIPALITY_DOMAIN} {
	import security_headers

	@dataDeletion path /data-deletion /data-deletion/
	handle @dataDeletion {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Veri Silme Talebi – cebtecep.com</title>
  <style>
    :root { color-scheme: light; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #1f2523; background: #f6f3ee; }
    body { margin: 0; padding: clamp(32px, 6vw, 96px) clamp(18px, 5vw, 72px); }
    h1 { font-size: clamp(24px, 4vw, 40px); margin: 0 0 16px; }
    p { line-height: 1.6; color: #4e5a55; max-width: 640px; }
    a { color: #26352f; }
  </style>
</head>
<body>
  <h1>Kullanıcı Verisi Silme Talebi</h1>
  <p>Meta platformları (WhatsApp, Instagram, Facebook) aracılığıyla cebtecep.com ile paylaştığınız kişisel verilerin silinmesini talep etmek için aşağıdaki e-posta adresine yazabilirsiniz:</p>
  <p><strong><a href="mailto:kvkk@cebtecep.com">kvkk@cebtecep.com</a></strong></p>
  <p>Talebiniz en geç 30 gün içinde işleme alınır ve size bilgi verilir. Konu satırına <em>"Veri Silme Talebi"</em> yazmanızı öneririz.</p>
</body>
</html>` 200
	}

	header Content-Type "text/html; charset=utf-8"
	respond `<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Demo Belediye</title>
  <style>
    :root { color-scheme: light; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #1f2523; background: #f6f3ee; }
    body { margin: 0; }
    header { background: #26352f; color: white; padding: 18px clamp(18px, 5vw, 72px); display: flex; justify-content: space-between; gap: 18px; align-items: center; }
    main { min-height: calc(100dvh - 74px); }
    .brand { font-weight: 900; letter-spacing: .02em; }
    nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: 14px; }
    nav a { color: white; text-decoration: none; opacity: .86; }
    .hero { padding: clamp(42px, 8vw, 96px) clamp(18px, 5vw, 72px); display: grid; gap: 28px; grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr); align-items: center; }
    .hero h1 { margin: 0; font-size: clamp(34px, 6vw, 72px); line-height: 1; letter-spacing: 0; max-width: 760px; }
    .hero p { margin: 0; color: #4e5a55; font-size: clamp(17px, 2vw, 21px); line-height: 1.55; max-width: 660px; }
    .panel { background: white; border: 1px solid #ded8ce; border-radius: 8px; padding: 24px; box-shadow: 0 20px 60px rgba(31, 37, 35, .12); display: grid; gap: 14px; }
    .panel strong { font-size: 18px; }
    .grid { padding: 0 clamp(18px, 5vw, 72px) 56px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .tile { background: white; border: 1px solid #ded8ce; border-radius: 8px; padding: 18px; min-height: 120px; }
    .tile h2 { margin: 0 0 8px; font-size: 18px; }
    .tile p { margin: 0; color: #59645f; line-height: 1.45; }
    @media (max-width: 820px) { header { align-items: flex-start; flex-direction: column; } .hero { grid-template-columns: 1fr; } .grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <header>
    <div class="brand">Demo Belediye</div>
    <nav aria-label="Ana navigasyon">
      <a href="#">Duyurular</a>
      <a href="#">Hizmetler</a>
      <a href="#">Basvuru</a>
      <a href="#">Iletisim</a>
    </nav>
  </header>
  <main>
    <section class="hero">
      <div>
        <h1>Mahalleniz icin hizli belediye hizmetleri</h1>
        <p>Bu sayfa Natro domaini uzerinde KentOS widget entegrasyonunu prova etmek icin hazirlanan demo belediye ana sayfasidir.</p>
      </div>
      <aside class="panel">
        <strong>Vatandas asistani yayinda</strong>
        <p>Sag alt kosedeki asistan butonu uzerinden talep, sikayet ve bilgi mesajlari WEB_CHAT kanalina aktarilir.</p>
      </aside>
    </section>
    <section class="grid" aria-label="Belediye hizmetleri">
      <article class="tile"><h2>Altyapi</h2><p>Yol, kaldirim, aydinlatma ve park sorunlari icin hizli bildirim.</p></article>
      <article class="tile"><h2>Temizlik</h2><p>Atik toplama, konteyner ve cevre temizligi talepleri.</p></article>
      <article class="tile"><h2>Takip</h2><p>Olusan basvurular takip koduyla vatandas tarafindan izlenebilir.</p></article>
    </section>
  </main>
  <script src="https://{$CITIZEN_DOMAIN}/widget.js" data-tenant="{$DEFAULT_TENANT_SLUG}" data-label="Belediye asistani" async></script>
</body>
</html>` 200
}

# ============================================================
# KentOS AI — Environment Variables Reference
# Tüm servisler için gerekli/opsiyonel değişkenler
# Kopyala: cp .env.example .env  →  değerleri doldur
# ============================================================

# ── Node ────────────────────────────────────────────────────
NODE_ENV=development           # development | production | test

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://kentos:kentos@localhost:5432/kentos_ai?schema=public
# Sadece docker-compose içinde kullanılır:
POSTGRES_USER=kentos
POSTGRES_PASSWORD=kentos
POSTGRES_DB=kentos_ai

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                # opsiyonel; prodüksiyonda set et

# ── API (apps/api) ──────────────────────────────────────────
PORT=3100
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# CORS_ORIGIN: prodüksiyonda ZORUNLU. Virgülle ayrılmış origin listesi.
CORS_ORIGIN=http://localhost:3101,http://localhost:3102
# Rate limiting (ThrottlerModule global defaults)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# ── Internal API Key ────────────────────────────────────────
# API ↔ Worker ↔ Gateway iletişiminde kullanılan dahili anahtar
INTERNAL_API_KEY=change-me-internal-key-min-32-chars

# ── S3 / MinIO (Dosya Depolama) ─────────────────────────────
S3_ENDPOINT=http://localhost:9000   # MinIO (dev) veya AWS S3 endpoint
S3_FORCE_PATH_STYLE=true            # MinIO için true, AWS S3 için false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kentos-attachments
S3_REGION=us-east-1                 # AWS S3 için gerekli

# ── ClamAV (Virüs Tarama) ───────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Citizen Web / Admin Web (Next.js) ───────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100/api/v1
NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://localhost:3100/api/v1
NEXT_PUBLIC_CITIZEN_WEB_BASE_URL=http://localhost:3102
PUBLIC_API_BASE_URL=http://localhost:3100/api/v1
PUBLIC_CITIZEN_BASE_URL=http://localhost:3102
# Widget embed script'inin iframe'ini açacağı citizen-web URL'i
CITIZEN_WEB_URL=http://localhost:3102

# ── Widget Güvenliği ────────────────────────────────────────
WIDGET_ORIGIN_ALLOWLIST=http://localhost:3000,http://localhost:3001
PUBLIC_RATE_LIMIT_MAX=60
PUBLIC_RATE_LIMIT_WINDOW_MS=60000

# ── WhatsApp Gateway (apps/whatsapp-gateway) ────────────────
# Gateway kendi portu
# PORT=3104  (gateway için ayrı .env veya override)

# Meta (WhatsApp / Instagram / Facebook)
# META_APP_SECRET: ZORUNLU — webhook imzası doğrulaması için
META_APP_SECRET=change-me-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=change-me-verify-token
PUBLIC_GATEWAY_BASE_URL=http://localhost:3104

# WhatsApp Cloud API (Meta Business)
# META_PHONE_NUMBER_ID: Meta Business Manager > WhatsApp > Phone Numbers
META_PHONE_NUMBER_ID=<Meta Business Manager Phone Number ID>
# META_ACCESS_TOKEN: System User Token (whatsapp_business_messaging scope)
META_ACCESS_TOKEN=<System User permanent access token>
# WHATSAPP_DEFAULT_TENANT_ID: Gelen mesajların yönlendirileceği tenant ID
WHATSAPP_DEFAULT_TENANT_ID=<tenant-id-for-inbound-routing>
# WHATSAPP_PROVIDER: Kullanılacak provider (meta-cloud | baileys)
WHATSAPP_PROVIDER=meta-cloud

# Twilio (SMS) — opsiyonel; set edilmezse SMS imza doğrulaması atlanır
TWILIO_AUTH_TOKEN=

# Postmark (Email inbound)
POSTMARK_INBOUND_BASIC_USER=
POSTMARK_INBOUND_BASIC_PASS=

# Outbound canlı gönderim flag'leri (true = gerçek gönderim, false/unset = DRY_RUN)
WHATSAPP_OUTBOUND_LIVE=false
INSTAGRAM_OUTBOUND_LIVE=false
FACEBOOK_OUTBOUND_LIVE=false
SMS_OUTBOUND_LIVE=false
EMAIL_OUTBOUND_LIVE=false

# WhatsApp 24h pencere dışı mesajlar için varsayılan onaylı template adı
# Meta Business Manager > WhatsApp > Message Templates'den alınır
WA_DEFAULT_NOTIFICATION_TEMPLATE=kentos_notification

# ── Worker (apps/worker) ─────────────────────────────────────
# Worker için aynı DATABASE_URL ve REDIS_URL gerekli (yukarıdaki)

# Retention — DİKKAT: false yapılmazsa DRY-RUN modunda çalışır (güvenli varsayılan)
RETENTION_DRY_RUN=true
RETENTION_DELETE_ATTACHMENT_OBJECTS=false

# Worker health check HTTP portu
WORKER_HEALTH_PORT=3130

# GIS Tabanlı Departman Ataması (F4)
# true = ticket lat/lon varsa Neighborhood polygon eşleştirmesi çalışır
ENABLE_GIS_ROUTING=false

# Tenant bazlı rate limiting (F8)
# Varsayılan: 300 istek / 60 saniye per tenant
TENANT_RATE_LIMIT=300
TENANT_RATE_WINDOW_SEC=60

# ── AI (Anthropic) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Kullanılacak Anthropic modeli
ANTHROPIC_MODEL=claude-sonnet-4-6
# Netiva AI (opsiyonel alternatif)
NETIVA_AI_API_KEY=
NETIVA_BASE_URL=https://api.netiva.com.tr/v1

# ── Error Monitoring (Sentry) ────────────────────────────────
# https://sentry.io adresinden DSN alın; boş bırakılırsa devre dışı
SENTRY_DSN=

# ── Bull Board Queue Monitor ──────────────────────────────────
# /admin/queues rotasında HTTP Basic Auth ile korunur
# Her ikisi de set edilmezse endpoint 503 döner
BULL_BOARD_USER=
BULL_BOARD_PASS=

# ── Citizen Web ──────────────────────────────────────────────
# Landing page'de "Başvuru oluştur" linklerinde kullanılacak varsayılan tenant
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=

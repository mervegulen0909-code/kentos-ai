CLAMAV_HOST=""
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
RETENTION_DRY_RUN=true
RETENTION_DELETE_ATTACHMENT_OBJECTS=false
AI_PROVIDER="stub"
AI_BASE_URL="https://api.netiva.com.tr/v1"
AI_API_KEY=""

AI_COST_INPUT_MICROS_PER_TOKEN="3"
AI_COST_OUTPUT_MICROS_PER_TOKEN="15"
NETIVA_BASE_URL="https://api.netiva.com.tr/v1"
NETIVA_API_KEY=""
NETIVA_MODEL="claude-sonnet-4-6"
NETIVA_TIMEOUT_MS=15000
NETIVA_MAX_TOKENS=1200
ANTHROPIC_API_KEY=""

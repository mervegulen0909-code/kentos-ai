INTERNAL_API_KEY="change-me-internal"
WIDGET_ORIGIN_ALLOWLIST="http://localhost:3002,http://127.0.0.1:3002"
PUBLIC_RATE_LIMIT_MAX=120
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
EMAIL_OUTBOUND_LIVE=false
